{
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python@6.1.5",
      "includeFiles": "api/**/*"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/server-status/record",
      "schedule": "*/5 * * * *"
    }
  ]
}
